{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Recto",
  "version": "1.0.0",
  "identifier": "com.recto.studio",
  "build": {
    "beforeDevCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Recto — Autonomous Desktop Publishing Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self' blob: data: 'unsafe-inline' 'unsafe-eval' https://fonts.googleapis.com https://fonts.gstatic.com;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "GraphicsAndDesign",
    "shortDescription": "Autonomous open-source desktop publishing studio",
    "longDescription": "High-fidelity, offline-first editorial layout and typography studio designed for independent publishers and zine creators.",
    "fileAssociations": [
      {
        "ext": ["recto", "papercut"],
        "name": "Recto Publication Document",
        "description": "Recto Studio Publication Document (.recto)",
        "role": "Editor",
        "mimeType": "application/x-recto"
      },
      {
        "ext": ["idml"],
        "name": "InDesign Markup Document",
        "description": "Adobe InDesign IDML Package (.idml)",
        "role": "Editor",
        "mimeType": "application/vnd.adobe.indesign-idml-package"
      },
      {
        "ext": ["indd"],
        "name": "Adobe InDesign Native Binary Document",
        "description": "Adobe InDesign Document (.indd)",
        "role": "Editor",
        "mimeType": "application/x-indesign"
      }
    ]
  }
}
