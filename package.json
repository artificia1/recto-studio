{
  "name": "recto-studio",
  "private": true,
  "version": "1.4.5",
  "description": "The open-source, web-first desktop publishing alternative to Adobe InDesign. Zero subscriptions, zero cloud telemetry, canvas editing, InDesign shortcuts, IDML import, and PDF export with bleed and marks.",
  "repository": {
    "type": "git",
    "url": "https://github.com/artificia1/recto-studio.git"
  },
  "homepage": "https://artificia1.github.io/recto-studio/",
  "keywords": [
    "desktop-publishing",
    "indesign-alternative",
    "dtp",
    "typography",
    "pdf-export",
    "prepress",
    "open-source",
    "local-first",
    "editorial-design",
    "zine"
  ],
  "license": "MIT",
  "author": "Abhinav Sidhu <artificia1@users.noreply.github.com>",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "analyze:bundle": "node scripts/bundle-report.mjs",
    "preview": "vite preview",
    "test": "node scripts/test.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "npm run test:e2e:typecheck && npm run build && playwright test",
    "test:e2e:typecheck": "tsc -p tsconfig.e2e.json",
    "test:e2e:ui": "npm run test:e2e:typecheck && npm run build && playwright test --ui",
    "test:all": "npm test",
    "cli": "node ./bin/recto.js",
    "desktop": "tauri dev",
    "desktop:serve": "node server.js",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "bin": {
    "recto": "./bin/recto.js"
  },
  "dependencies": {
    "@kittl/little-cms": "1.0.3",
    "@napi-rs/canvas": "1.1.0",
    "@resvg/resvg-js": "2.6.2",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "acorn": "^8.19.0",
    "ag-psd": "^31.0.3",
    "clipper-lib": "6.4.2",
    "fontkit": "^2.0.4",
    "harfbuzzjs": "^1.6.3",
    "hyphenation.de": "^0.2.1",
    "hyphenation.en-us": "^0.2.1",
    "hyphenation.fr": "^0.2.1",
    "hypher": "^0.2.5",
    "jspdf": "^4.2.1",
    "mathjax-full": "3.2.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "preact": "^10.19.6",
    "svg2pdf.js": "2.7.0",
    "trystero": "^0.26.0",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.8.2",
    "@tauri-apps/cli": "^2.12.4",
    "@types/estree": "^1.0.10",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  }
}
