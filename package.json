{
  "name": "papercut-studio",
  "private": true,
  "version": "1.0.0",
  "description": "The open-source, web-first desktop publishing alternative to Adobe InDesign. Zero subscriptions, zero cloud telemetry, locked 60 FPS canvas, with InDesign shortcuts, IDML import, and print-ready PDF/X export.",
  "repository": {
    "type": "git",
    "url": "https://github.com/artificia1/papercut-studio.git"
  },
  "homepage": "https://artificia1.github.io/papercut-studio/",
  "keywords": [
    "desktop-publishing",
    "indesign-alternative",
    "dtp",
    "typography",
    "pdf-export",
    "prepress",
    "open-source",
    "local-first",
    "editorial-design",
    "zine"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:all": "vitest run && npx tsx test.ts",
    "desktop": "node server.js",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "jspdf": "^2.5.2",
    "preact": "^10.19.6"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.8.2",
    "@types/node": "^26.6.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^5.0.5"
  }
}
